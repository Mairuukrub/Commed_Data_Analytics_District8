    "import numpy as np\n",
    "\n",
    "def wilson(x, n, z=1.96):\n",
    "    p = x / n\n",
    "    denom = 1 + z**2 / n\n",
    "    center = (p + z**2 / (2 * n)) / denom\n",
    "    half = z * np.sqrt(p * (1 - p) / n + z**2 / (4 * n**2)) / denom\n",
    "    return center - half, center + half\n",
    "\n",
    "pv[\"lo\"], pv[\"hi\"] = wilson(pv[\"result\"], pv[\"target\"])\n",
    "pv[\"lo\"] *= 100\n",
    "pv[\"hi\"] *= 100\n",
    "\n",
    "print(pv[[\"target\", \"result\", \"pct1_คำนวณ\", \"lo\", \"hi\"]].round(1).to_string())"
